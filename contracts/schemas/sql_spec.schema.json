{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/sql_spec.schema.json",
  "title": "SQLSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "plan_id", "dialect", "sql", "params", "expected_shape"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^0\\.1\\.\\d+$" },
    "trace_id": { "type": "string" },
    "plan_id": { "type": "string" },

    "dialect": { "type": "string", "enum": ["postgres", "sqlite"] },

    "sql": { "type": "string", "minLength": 20 },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "value"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["string", "number", "date", "boolean"] },
          "value": {}
        }
      }
    },

    "expected_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "max_rows"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string", "enum": ["string", "number", "date", "boolean"] }
            }
          }
        },
        "max_rows": { "type": "integer", "minimum": 1, "maximum": 5000 }
      }
    },

    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read_only": { "type": "boolean", "const": true },
        "no_select_star": { "type": "boolean", "const": true },
        "bounded": { "type": "boolean", "const": true }
      }
    }
  }
}
