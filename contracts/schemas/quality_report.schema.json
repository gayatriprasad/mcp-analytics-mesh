{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/quality_report.schema.json",
  "title": "QualityReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "plan_id", "freshness", "dq_score", "checks", "warnings"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^0\\.1\\.\\d+$" },
    "trace_id": { "type": "string" },
    "plan_id": { "type": "string" },

    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_ingested_at", "sla_hours", "is_stale"],
      "properties": {
        "last_ingested_at": { "type": "string", "format": "date-time" },
        "sla_hours": { "type": "integer", "minimum": 1 },
        "is_stale": { "type": "boolean" }
      }
    },

    "dq_score": { "type": "integer", "minimum": 0, "maximum": 100 },

    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "details"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
          "details": { "type": "object" }
        }
      }
    },

    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
