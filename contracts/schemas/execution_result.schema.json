{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/execution_result.schema.json",
  "title": "ExecutionResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "plan_id", "sql_hash", "rowcount", "runtime_ms", "data", "metadata"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^0\\.1\\.\\d+$" },
    "trace_id": { "type": "string" },
    "plan_id": { "type": "string" },

    "sql_hash": { "type": "string", "minLength": 16 },
    "rowcount": { "type": "integer", "minimum": 0 },
    "runtime_ms": { "type": "integer", "minimum": 0 },

    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows"],
      "properties": {
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array", "items": { "type": "array", "items": {} } }
      }
    },

    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "executed_at", "db", "limits_applied"],
      "properties": {
        "snapshot_id": { "type": "string" },
        "executed_at": { "type": "string", "format": "date-time" },
        "db": { "type": "string" },
        "limits_applied": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_rows", "timeout_ms"],
          "properties": {
            "max_rows": { "type": "integer" },
            "timeout_ms": { "type": "integer" }
          }
        }
      }
    }
  }
}
