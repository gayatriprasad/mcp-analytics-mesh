{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/policy_decision.schema.json",
  "title": "PolicyDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "plan_id", "decision", "constraints"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^0\\.1\\.\\d+$" },
    "trace_id": { "type": "string" },
    "plan_id": { "type": "string" },

    "decision": { "type": "string", "enum": ["allow", "deny", "allow_with_constraints"] },
    "reason": { "type": "string" },

    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_filters", "masked_fields", "max_rows", "timeout_ms", "allowed_tables"],
      "properties": {
        "allowed_tables": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "allowed_fields": { "type": "array", "items": { "type": "string" } },

        "row_filters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "op", "value"],
            "properties": {
              "field": { "type": "string" },
              "op": { "type": "string", "enum": ["=", "in"] },
              "value": {}
            }
          }
        },

        "masked_fields": { "type": "array", "items": { "type": "string" } },

        "max_rows": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 20000 }
      }
    }
  }
}
