{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/query_plan.schema.json",
  "title": "QueryPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "plan_id", "intent", "time_window", "grain", "select", "filters"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^0\\.1\\.\\d+$" },
    "trace_id": { "type": "string", "minLength": 8 },
    "plan_id": { "type": "string", "minLength": 8 },
    "intent": { "type": "string", "enum": ["aggregate", "trend", "topk", "compare", "diagnose"] },

    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date"],
      "properties": {
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" }
      }
    },

    "grain": { "type": "string", "enum": ["day", "week", "month", "quarter", "year"] },

    "select": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "dimensions"],
      "properties": {
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "agg"],
            "properties": {
              "name": { "type": "string" },
              "agg": { "type": "string", "enum": ["sum", "count", "count_distinct", "avg", "min", "max"] },
              "alias": { "type": "string" }
            }
          }
        },
        "dimensions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "op", "value"],
        "properties": {
          "field": { "type": "string" },
          "op": { "type": "string", "enum": ["=", "!=", ">", ">=", "<", "<=", "in", "not_in", "like", "between"] },
          "value": {},
          "value_type": { "type": "string", "enum": ["string", "number", "date", "array", "range", "boolean", "null"] }
        }
      }
    },

    "sort": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "direction"],
        "properties": {
          "field": { "type": "string" },
          "direction": { "type": "string", "enum": ["asc", "desc"] }
        }
      }
    },

    "limit": { "type": "integer", "minimum": 1, "maximum": 5000, "default": 200 },

    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },

    "risk_flags": {
      "type": "array",
      "items": { "type": "string", "enum": ["ambiguous_metric", "ambiguous_date", "high_cardinality", "potential_pii", "currency_mismatch"] }
    }
  }
}
